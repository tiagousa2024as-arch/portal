# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Senha para entrar no portal (escolha uma forte)
PORTAL_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de sessão (qualquer texto longo e aleatório, 32+ caracteres)
SESSION_SECRET=gere-um-texto-aleatorio-bem-longo-aqui

# Supabase (Project Settings > API). A service role fica SÓ no servidor, nunca no navegador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Claude API (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado pelo assistente
ANTHROPIC_MODEL=claude-sonnet-5-5
# Teto de perguntas ao Lastro por dia, no servidor. 0 deixa sem teto.
AI_DAILY_LIMIT=40

# Segredo do cron de sábado (Vercel envia Authorization: Bearer). Sem ele a rota recusa.
CRON_SECRET=gere-outro-texto-aleatorio-bem-longo

# Avisos no celular (Web Push). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
# Fuso dos avisos. O cron das 13:00 UTC cai de manhã neste fuso.
AVISOS_TZ=America/New_York

# Cotações da B3 (brapi.dev > Dashboard). Só no servidor.
BRAPI_API_KEY=sua-chave-brapi
